{
  "uid": "htl-totals",
  "title": "Totals",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Revenue, costs and profit",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/totals",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "source",
              "text": "Source",
              "type": "string"
            },
            {
              "selector": "revenue",
              "text": "Revenue",
              "type": "number"
            },
            {
              "selector": "costs",
              "text": "Costs",
              "type": "number"
            },
            {
              "selector": "profit",
              "text": "Profit",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(revenue|profit|value|cost|price|net).*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*minutes.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*grams.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "massg"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Not in the total",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/totals-extra",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "label",
              "text": "Line",
              "type": "string"
            },
            {
              "selector": "minutes",
              "text": "Minutes",
              "type": "number"
            },
            {
              "selector": "value",
              "text": "Value",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(revenue|profit|value|cost|price|net).*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*minutes.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*grams.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "massg"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Profit per period",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/profit-trend",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "period",
              "text": "Period",
              "type": "string"
            },
            {
              "selector": "Drinks",
              "text": "Drinks",
              "type": "number"
            },
            {
              "selector": "Wood",
              "text": "Wood",
              "type": "number"
            },
            {
              "selector": "Filament",
              "text": "Filament",
              "type": "number"
            },
            {
              "selector": "Other items",
              "text": "Other items",
              "type": "number"
            },
            {
              "selector": "Laser",
              "text": "Laser",
              "type": "number"
            },
            {
              "selector": "Machines (3D print, CNC)",
              "text": "Machines (3D print, CNC)",
              "type": "number"
            },
            {
              "selector": "Volunteer items",
              "text": "Volunteer items",
              "type": "number"
            },
            {
              "selector": "Lab use",
              "text": "Lab use",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(revenue|profit|value|cost|price|net).*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*minutes.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*grams.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "massg"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "period",
        "orientation": "vertical",
        "stacking": "normal",
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
