{
  "uid": "htl-totals",
  "title": "Totals",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Revenue, costs and profit",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/totals",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "source",
              "text": "Source",
              "type": "string"
            },
            {
              "selector": "revenue",
              "text": "Revenue",
              "type": "number"
            },
            {
              "selector": "costs",
              "text": "Costs",
              "type": "number"
            },
            {
              "selector": "profit",
              "text": "Profit",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "fieldConfig": {
        "defaults": {
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/(revenue|profit|value|cost|price|net|amount)/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/minutes/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/grams/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "massg"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Not in the total",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/totals-extra",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "label",
              "text": "Line",
              "type": "string"
            },
            {
              "selector": "minutes",
              "text": "Minutes",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "Amount",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/(revenue|profit|value|cost|price|net|amount)/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/minutes/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/grams/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "massg"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Minutes"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Profit per period",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/profit-trend",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              }
            ]
          },
          "root_selector": "",
          "columns": [],
          "computed_columns": []
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "",
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "gradientMode": "none",
            "drawStyle": "bars",
            "barAlignment": 1,
            "barWidthFactor": 0.8,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "decimals": 2,
          "unit": "currencyEUR"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Drinks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Wood"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Filament"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Other items"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Laser"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Machines (3D print, CNC)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Volunteer items"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lab use"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "net"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Net profit"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.pointSize",
                "value": 6
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.barAlignment",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Stacked bars: profit per source, costs below zero. Black line: net profit. Legend shows the total per source.",
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "period",
                "destinationType": "time",
                "dateFormat": "YYYY-MM-DD"
              }
            ],
            "fields": {}
          }
        }
      ]
    }
  ]
}
