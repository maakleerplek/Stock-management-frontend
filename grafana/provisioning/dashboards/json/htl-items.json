{
  "uid": "htl-items",
  "title": "Items",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "kind",
        "label": "Sales",
        "type": "custom",
        "query": "all,paid,volunteer",
        "current": {
          "text": "all",
          "value": "all"
        },
        "options": [
          {
            "text": "all",
            "value": "all",
            "selected": true
          },
          {
            "text": "paid",
            "value": "paid",
            "selected": false
          },
          {
            "text": "volunteer",
            "value": "volunteer",
            "selected": false
          }
        ]
      },
      {
        "name": "part",
        "label": "Part",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "htl-analytics"
        },
        "refresh": 1,
        "sort": 5,
        "query": {
          "refId": "variable",
          "queryType": "infinity",
          "infinityQuery": {
            "type": "json",
            "source": "url",
            "url": "http://analytics:8080/parts",
            "root_selector": "",
            "format": "table",
            "columns": [
              {
                "selector": "name",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "part_id",
                "text": "__value",
                "type": "number"
              }
            ],
            "parser": "backend",
            "refId": "variable"
          }
        },
        "definition": "http://analytics:8080/parts"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Totals",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/items-summary",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "kind",
                "value": "${kind}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "transactions",
              "text": "Transactions",
              "type": "number"
            },
            {
              "selector": "units_out",
              "text": "Units out",
              "type": "number"
            },
            {
              "selector": "volunteer_units",
              "text": "Volunteer units",
              "type": "number"
            },
            {
              "selector": "internal_use_units",
              "text": "Internal use units",
              "type": "number"
            },
            {
              "selector": "revenue",
              "text": "Revenue",
              "type": "number"
            },
            {
              "selector": "profit",
              "text": "Profit",
              "type": "number"
            },
            {
              "selector": "volunteer_and_lab_cost",
              "text": "Volunteer and lab cost",
              "type": "number"
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/(revenue|profit|value|cost|price|net)/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/minutes/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/grams/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "massg"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
