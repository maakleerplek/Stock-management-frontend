{
  "uid": "htl-workshops",
  "title": "Workshops",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "HTL workshops on the agenda",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "htl-analytics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "htl-analytics"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://analytics:8080/workshops",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              }
            ]
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "when",
              "text": "Date",
              "type": "string"
            },
            {
              "selector": "time",
              "text": "Time",
              "type": "string"
            },
            {
              "selector": "title",
              "text": "Workshop",
              "type": "string"
            },
            {
              "selector": "price",
              "text": "Price",
              "type": "string"
            },
            {
              "selector": "location",
              "text": "Location",
              "type": "string"
            },
            {
              "selector": "link",
              "text": "Link",
              "type": "string"
            }
          ]
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/(revenue|profit|value|cost|price|net)/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyEUR"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/minutes/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/grams/i"
            },
            "properties": [
              {
                "id": "unit",
                "value": "massg"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}