# =============================================================================
# ORGANIZATION DETAILS
# =============================================================================
# Organization name (displayed in footer and payment details)
VITE_ORGANIZATION_NAME="Your Organization Name"
# Organization website URL (linked from logo)
VITE_ORGANIZATION_URL="https://your-organization.com/"

# =============================================================================
# INVENTREE API CONNECTION
# =============================================================================
# IMPORTANT: Leave this EMPTY to use relative URLs through the Caddy proxy
# This prevents mixed content errors (HTTP/HTTPS) and ensures all requests
# go through the HTTPS Caddy reverse proxy
VITE_INVENTREE_URL=

# InvenTree API token (generate from InvenTree: Settings -> API Tokens).
# Runtime only: the proxy adds it to API calls, the browser never gets it.
# Use a dedicated InvenTree user with only the roles this app needs,
# not a superuser.
INVENTREE_TOKEN=your-inventree-api-token-here

# Backend URL for Caddy to proxy API and media requests to InvenTree
# This is used at runtime by the Caddy reverse proxy (from Docker container's perspective)
# Use the IP/hostname that the Docker container can reach
INVENTREE_BACKEND_URL=http://192.168.1.100:8080

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Volunteers sign in through Authentik; signed in = volunteer. oauth2-proxy
# (docker-compose.yml) runs the sign-in, nginx asks it on every volunteer call.
# In Authentik: an OAuth2/OpenID provider (confidential client) with redirect
# URI  <PUBLIC_URL>/oauth/callback , plus an application bound to it.
#
# The address people use; the sign-in only works there, not on the bare IP.
PUBLIC_URL=https://stock.int.maakleerplek.be
OIDC_ISSUER_URL=https://auth.maakleerplek.be/application/o/htl-prod-stock/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Signing out also ends the Authentik session (shared devices), so the next
# person has to sign in again. The host must be allowed as a redirect target.
OIDC_LOGOUT_URL=https://auth.maakleerplek.be/application/o/htl-prod-stock/end-session/
OIDC_LOGOUT_HOST=auth.maakleerplek.be
# Encrypts the session cookie. Generate once:
#   python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_COOKIE_SECRET=
# Without the email/profile scope mappings in Authentik, use:
# OIDC_SCOPE=openid
# OIDC_EMAIL_CLAIM=sub
#
# Local development has no Authentik: "Sign in" just sets a dev cookie.
# DEV_VOLUNTEER=false turns that off to test what the till sees.

# =============================================================================
# PRICING - EXTRA SERVICES
# =============================================================================
# Price per minute for laser cutting service (also used by the laser service)
VITE_LASER_PRICE_PER_MIN=0.50

# =============================================================================
# LASER SERVICE (laser/)
# =============================================================================
# 1 = test mode without the ESP32: the Lasercutter tab gets an on/off button.
LASER_SIMULATE=0
# UDP port on the host where the ESP32 sends laser ON/OFF (serverIP:5005 in monitor.ino)
LASER_UDP_PORT=5005
# Price per gram for 3D printing service
VITE_PRINT_PRICE_PER_GRAM=0.10
# Currency code (EUR, USD, GBP, etc.)
VITE_CURRENCY=EUR

# =============================================================================
# WERO (EPC QR) PAYMENT INTEGRATION
# =============================================================================
# Name to appear on QR payment requests
VITE_PAYMENT_NAME="Your Organization Name"
# IBAN for receiving payments
VITE_PAYMENT_IBAN="BE00000000000000"
# Payconiq Merchant ID for Payconiq payment link (optional, leave empty if not using Payconiq)
VITE_PAYCONIQ_MERCHANT_ID=""

# =============================================================================
# FOOTER LINKS CONFIGURATION
# =============================================================================
# Link to InvenTree documentation
VITE_DOCS_URL="https://docs.inventree.org/en/stable/"
# Link to feedback form (optional)
VITE_FEEDBACK_URL="https://your-feedback-url.com"
# Link to GitHub repository (optional)
VITE_GITHUB_URL="https://github.com/your-org/your-repo"

# =============================================================================
# TV PRESENTATION INTEGRATION
# =============================================================================
# URL of the tv-presentation Next.js server (e.g. http://10.72.3.141:8083)
# Leave empty to disable changelog reporting
VITE_TV_PRESENTATION_URL=http://10.72.1.246:8083

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# HTTP port for frontend (default: 8082)
FRONTEND_HTTP_PORT=8082
# HTTPS port for frontend (default: 8444)
FRONTEND_HTTPS_PORT=8444
