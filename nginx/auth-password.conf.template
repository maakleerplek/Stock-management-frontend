# AUTH_MODE=password: one shared volunteer password, for a server that cannot
# reach Authentik (the test server). The app stores sha256(password) in the
# volunteer_key cookie; nginx compares it with VOLUNTEER_KEY from entrypoint.sh.
# Included in the HTTPS server block of nginx.conf.template.

# The check behind every auth_request: 204 with the right key, 401 otherwise.
location = /oauth/auth {
    internal;
    if ($cookie_volunteer_key = "${VOLUNTEER_KEY}") {
        return 204;
    }
    return 401;
}

# Signing out forgets the key.
location = /logout {
    add_header Set-Cookie "volunteer_key=; Path=/; Max-Age=0; Secure; SameSite=Strict";
    return 302 /;
}

# No Authentik here.
location /oauth/ {
    return 404;
}
