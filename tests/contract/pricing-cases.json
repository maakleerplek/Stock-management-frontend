{
  "_doc": "Shared pricing contract. Run by core/tests/test_pricing_contract.py (core/checkout.py quote) and tests/pricingContract.test.ts (src/api/inventreeClient.ts sale prices; src/lib/totals.ts is analytics and has no pricing). A case with known_mismatch is skipped in the impl named there.",
  "constants": { "till_customer": "Walk-in customer" },
  "world": {
    "sale_breaks": [
      { "part": 1, "quantity": 1, "price": "1.50" },
      { "part": 1, "quantity": 6, "price": "1.20" },
      { "part": 2, "quantity": 10, "price": "0.80" },
      { "part": 2, "quantity": 2, "price": "1.00" },
      { "part": 4, "quantity": 1, "price": "0.333" },
      { "part": 97, "quantity": 1, "price": "0.50" },
      { "part": 98, "quantity": 1, "price": "1.00" }
    ],
    "parts": [
      { "pk": 1, "name": "Cola" },
      { "pk": 2, "name": "Chips" },
      { "pk": 3, "name": "Mystery" },
      { "pk": 4, "name": "Sweet" },
      { "pk": 10, "name": "PLA Black (1 kg)" },
      { "pk": 11, "name": "PLA White (1 kg)" },
      { "pk": 97, "name": "Lasercutter", "category": "Machinegebruik" },
      { "pk": 98, "name": "CNC", "category": "Machinegebruik" }
    ],
    "minimums": { "97": 5, "98": 5 },
    "per_gram": { "10": 0.08 },
    "defaults": { "print_per_gram": 0.10, "own_per_gram": 0.03, "print_minimum": 5 }
  },
  "cases": [
    { "name": "smallest_price_break", "cart": { "items": [{ "part": 1, "quantity": 2 }] },
      "expected": { "total": 3.0, "top_up": 0, "items": [{ "part": 1, "unit_price": 1.5 }] } },
    { "name": "smallest_quantity_beats_lowest_price", "cart": { "items": [{ "part": 2, "quantity": 3 }] },
      "expected": { "total": 3.0, "top_up": 0, "items": [{ "part": 2, "unit_price": 1.0 }] } },
    { "name": "bulk_break_is_not_applied", "cart": { "items": [{ "part": 1, "quantity": 10 }] },
      "expected": { "total": 15.0, "top_up": 0, "items": [{ "part": 1, "unit_price": 1.5 }] } },
    { "name": "part_without_sale_price", "cart": { "items": [{ "part": 3, "quantity": 1 }] },
      "expected": { "error": "No price for Mystery" },
      "known_mismatch": "typescript: inventreeClient prices it 0 (`?? 0`), no error; rust: kiosk price() shows 0 and only refuses at checkout" },
    { "name": "print_default_price_per_gram", "cart": { "prints": [{ "part": 11, "material": "PLA White (1 kg)", "grams": 60 }] },
      "expected": { "total": 6.0, "top_up": 0, "extras": [{ "kind": "print", "quantity": 60, "unit_price": 0.1, "booked_price": 0.1 }] } },
    { "name": "print_below_minimum_is_topped_up", "cart": { "prints": [{ "part": 10, "material": "PLA Black (1 kg)", "grams": 50 }] },
      "expected": { "total": 5.0, "top_up": 1.0, "extras": [{ "kind": "print", "quantity": 50, "unit_price": 0.08, "booked_price": 0.1 }] } },
    { "name": "print_own_spool", "cart": { "prints": [{ "part": 10, "material": "PLA", "grams": 100, "own": true }] },
      "expected": { "total": 5.0, "top_up": 2.0, "extras": [{ "kind": "print", "quantity": 100, "unit_price": 0.03, "booked_price": 0.05 }] } },
    { "name": "laser_cuts_rounded_up_once", "cuts": [{ "id": "a", "name": "A", "total_time": 70 }, { "id": "b", "name": "B", "total_time": 70 }],
      "cart": { "cuts": ["a", "b"] },
      "expected": { "total": 5.0, "top_up": 3.5, "extras": [{ "kind": "laser", "quantity": 3, "unit_price": 0.5, "booked_price": 1.6666667 }] } },
    { "name": "laser_seconds_rounded_to_milliseconds_first", "cuts": [{ "id": "a", "name": "A", "total_time": 30.0002 }, { "id": "b", "name": "B", "total_time": 30.0002 }],
      "cart": { "cuts": ["a", "b"] },
      "expected": { "total": 5.0, "top_up": 4.5, "extras": [{ "kind": "laser", "quantity": 1, "unit_price": 0.5, "booked_price": 5.0 }] } },
    { "name": "minimum_once_spread_in_proportion", "cart": { "prints": [{ "part": 11, "material": "PLA", "grams": 30 }], "machines": [{ "tool": "cnc", "minutes": 1 }] },
      "expected": { "total": 5.0, "top_up": 1.0, "extras": [{ "kind": "print", "quantity": 30, "unit_price": 0.1, "booked_price": 0.125 }, { "kind": "cnc", "quantity": 1, "unit_price": 1.0, "booked_price": 1.25 }] } },
    { "name": "products_do_not_count_towards_minimum", "cart": { "items": [{ "part": 1, "quantity": 2 }], "machines": [{ "tool": "laser", "minutes": 2 }] },
      "expected": { "total": 8.0, "top_up": 4.0, "items": [{ "part": 1, "unit_price": 1.5 }], "extras": [{ "kind": "laser", "quantity": 2, "unit_price": 0.5, "booked_price": 2.5 }] } },
    { "name": "above_minimum_no_top_up", "cart": { "machines": [{ "tool": "laser", "minutes": 20 }] },
      "expected": { "total": 10.0, "top_up": 0, "extras": [{ "kind": "laser", "quantity": 20, "unit_price": 0.5, "booked_price": 0.5 }] } },
    { "name": "volunteer_is_free", "cart": { "volunteer": true, "items": [{ "part": 1, "quantity": 2 }], "machines": [{ "tool": "laser", "minutes": 20 }] },
      "expected": { "total": 0, "top_up": 0, "items": [{ "part": 1, "unit_price": 0 }], "extras": [{ "kind": "laser", "quantity": 20, "unit_price": 0, "booked_price": 0 }] } },
    { "name": "machine_without_price_uses_fallback_and_no_minimum", "world_patch": { "drop_sale_prices": [97], "drop_minimums": [97] },
      "cart": { "machines": [{ "tool": "laser", "minutes": 3 }] },
      "expected": { "total": 1.5, "top_up": 0, "extras": [{ "kind": "laser", "quantity": 3, "unit_price": 0.5, "booked_price": 0.5 }] } },
    { "name": "total_rounded_to_cents", "cart": { "items": [{ "part": 4, "quantity": 3 }] },
      "expected": { "total": 1.0, "top_up": 0, "items": [{ "part": 4, "unit_price": 0.333 }] } }
  ]
}
