# Access rules for the InvenTree proxy. src/lib/apiAccess.ts holds the same
# rules for the Vite dev server (and their tests) - keep the two in step.
#
# The browser never sees the InvenTree token: nginx adds it to every request.
# A volunteer is anyone with a valid sign-in session from oauth2-proxy (the
# sidecar in docker-compose.yml, signed in through Authentik). nginx asks it on
# every volunteer-only request (auth_request); the session is an encrypted
# cookie, so the browser cannot claim to be a volunteer by itself.

# WebSocket upgrade for the laser service's Socket.IO.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name _;

    # Health check must be in a location block: a server-context return runs before locations.
    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    # $host has no port, so name the published HTTPS port; without it the
    # redirect lands on port 443 of the host, which is another service.
    location / {
        return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name _;

    client_max_body_size 20M;

    ssl_certificate /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/x-javascript text/xml application/xml application/rss+xml image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";

    root /usr/share/nginx/html;
    index index.html;

    # Inherited by every proxied location below.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "Token ${INVENTREE_TOKEN}";
    proxy_ssl_verify off;

    location /health {
        access_log off;
        return 200 "healthy\n";
    }

    # oauth2-proxy is looked up per request (Docker's DNS), so nginx still
    # starts, and the till still works, while the sign-in service is down.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $oauth2_proxy http://oauth2-proxy:4180;

    # Sign-in, callback, sign-out and user info, served by oauth2-proxy.
    # Its own headers only: the InvenTree token must never reach it.
    location /oauth/ {
        proxy_pass $oauth2_proxy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Auth-Request-Redirect $request_uri;
        proxy_set_header Authorization "";
        # The session cookie carries the ID token and can be large.
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }

    # The auth_request target: 202 when signed in, 401 otherwise.
    location = /oauth/auth {
        internal;
        proxy_pass $oauth2_proxy;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Authorization "";
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }

    # Ends the session here and at Authentik, so the next person on a shared
    # device has to sign in again.
    location = /logout {
        return 302 /oauth/sign_out?rd=${OIDC_LOGOUT_URL};
    }

    # The app asks here whether this browser has a volunteer session.
    # try_files runs after the access check; a plain return would run before it.
    location = /api/auth/check/ {
        auth_request /oauth/auth;
        try_files /__never__ @volunteer_ok;
    }
    location @volunteer_ok {
        return 204;
    }

    # Checkout: barcode lookups and the sales order, open to the till.
    location ~ ^/api/(barcode/|order/so/(shipment/(\d+/ship/)?|\d+/(issue|allocate|complete|cancel)/)?|order/so-line/|order/so-extra-line/)$ {
        proxy_pass ${INVENTREE_BACKEND_URL};
    }

    # Catalogue: anyone may read, volunteers may write. Writes are sent on to
    # the checked location below; rewrite...last is one of the safe uses of if.
    location ~ ^/api/(part|stock|company|order|barcode)/ {
        if ($request_method !~ ^(GET|HEAD)$) {
            rewrite ^ /__volunteer$uri last;
        }
        proxy_pass ${INVENTREE_BACKEND_URL};
    }

    location ^~ /__volunteer/ {
        internal;
        auth_request /oauth/auth;
        rewrite ^/__volunteer(/.*)$ $1 break;
        proxy_pass ${INVENTREE_BACKEND_URL};
    }

    # The laser material library: anyone may read it, volunteers may change it.
    # Writes go through the signed-in check below, like the catalogue writes.
    location /laser/api/library {
        if ($request_method !~ ^(GET|HEAD)$) {
            rewrite ^ /__laser_volunteer$uri last;
        }
        set $laser_upstream http://laser:5000;
        proxy_pass $laser_upstream;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }

    location ^~ /__laser_volunteer/ {
        internal;
        auth_request /oauth/auth;
        rewrite ^/__laser_volunteer(/.*)$ $1 break;
        set $laser_upstream http://laser:5000;
        proxy_pass $laser_upstream;
        proxy_set_header Host $host;
        proxy_set_header Authorization "";
    }

    # Laser time tracking and settings: the laser service (laser/ in this repo).
    # Looked up per request, so the till still starts when that container is
    # down. Its own headers only: the InvenTree token must never reach it.
    location /laser/ {
        set $laser_upstream http://laser:5000;
        proxy_pass $laser_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization "";
        proxy_read_timeout 1h;
    }

    # Everything else (users, settings, admin, ...) is volunteers only.
    location /api/ {
        auth_request /oauth/auth;
        proxy_pass ${INVENTREE_BACKEND_URL};
    }

    # ^~ beats the static-asset regex below for images under /media/.
    location ^~ /media/ {
        proxy_pass ${INVENTREE_BACKEND_URL};
    }

    # The PWA's update machinery and the page that loads it must always be
    # re-checked; cached for a year they pin every browser to an old build.
    # (add_header here replaces the server-level ones, so repeat them.)
    location ~* ^/(?:sw\.js|registerSW\.js|workbox-[^/]+\.js|manifest\.webmanifest|index\.html)$ {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";
        add_header X-XSS-Protection "1; mode=block";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";
        add_header X-XSS-Protection "1; mode=block";
    }
}
